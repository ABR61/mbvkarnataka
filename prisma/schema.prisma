// MBV — Manava Bandhutva Vedike — Occupational Training Platform
// Phase 1 data model (Training Operations Core) + Auth.js v5 models.
// See docs/DATA_MODEL.md for the ERD. Localized text fields use Json: { "en": "...", "kn": "..." }.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (CLI) and the
  // driver adapter in src/lib/prisma.ts (runtime) — not here.
}

// ─────────────────────────────────────────────────────────────
// Auth.js v5 (next-auth) — required adapter models
// `User` is also our application user (extended with app fields).
// ─────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // for Credentials sign-in (bcrypt)
  locale        String     @default("en") // "en" | "kn"
  status        UserStatus @default(ACTIVE)
  districtId    String? // set for branch (district) admins; null = unrestricted (super admin)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  district          District?    @relation(fields: [districtId], references: [id])
  accounts          Account[]
  sessions          Session[]
  person            Person?
  userRoles         UserRole[]
  attendancesMarked Attendance[] @relation("AttendanceMarkedBy")
  posts             Post[]
  futurePrograms    FutureProgram[]
  completions       Completion[] @relation("UserCompletions")

  @@index([districtId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Trainee | Trainer | Coordinator | CenterManager | Finance | Placement | Admin
  description String?
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "attendance.mark", "cohort.manage"
  description String?

  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────────────────────────────────────────────
// People
// ─────────────────────────────────────────────────────────────

model Person {
  id          String     @id @default(cuid())
  userId      String?    @unique
  kind        PersonKind @default(TRAINEE) // trainee | trainer | staff
  firstName   String
  lastName    String?
  dateOfBirth DateTime?
  gender      Gender?
  phone       String?
  email       String?
  address     String?
  districtId  String?
  photoUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  district           District?           @relation(fields: [districtId], references: [id])
  enrollments        Enrollment[]
  attendances        Attendance[]
  trainerSessions    TrainingSession[]   @relation("SessionTrainer")
  coordinatedCohorts Cohort[]            @relation("CohortCoordinator")
  trainerAssignments TrainerAssignment[]
  documents          Document[]
  consentRecords     ConsentRecord[]
  application        Application?
  certificates       Certificate[]
  placements         Placement[]

  @@index([districtId])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────
// Geography
// ─────────────────────────────────────────────────────────────

model District {
  id    String  @id @default(cuid())
  name  Json // { en, kn }
  code  String? @unique
  state String  @default("Karnataka")

  centers        Center[]
  persons        Person[]
  applications   Application[]
  employers      Employer[]
  admins         User[]
  posts          Post[]
  futurePrograms FutureProgram[]
  completions    Completion[]
}

// ─────────────────────────────────────────────────────────────
// Future programs (planned by branch admins for their district)
// ─────────────────────────────────────────────────────────────

model FutureProgram {
  id            String   @id @default(cuid())
  districtId    String
  authorId      String?
  title         String
  description   String
  imageUrl      String? // optional photo (data URL or external link)
  objectives    String?
  resources     String?
  category      String?
  plannedFor    String? // e.g. "March 2026" / a timeframe
  durationWeeks Int? // numeric duration value
  durationUnit  String? // "days" | "weeks" | "months"
  seats         Int? // how many people can join
  approved      Boolean  @default(false) // super admin approves before it's public
  createdAt     DateTime @default(now())

  district     District      @relation(fields: [districtId], references: [id], onDelete: Cascade)
  author       User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  completions  Completion[]
  applications Application[]

  @@index([districtId])
}

// ─────────────────────────────────────────────────────────────
// Program completions & participant feedback
// ─────────────────────────────────────────────────────────────

// A participant an admin/branch admin has marked as having COMPLETED a program
// (either a main training Program or an announced FutureProgram). Only people
// with a completion may submit feedback for that program.
model Completion {
  id              String   @id @default(cuid())
  userId          String // the participant (a student User)
  programId       String? // set when the completed program is a training Program
  futureProgramId String? // set when it is a FutureProgram
  districtId      String? // for branch-admin scoping
  markedById      String? // admin/branch admin who recorded it
  createdAt       DateTime @default(now())

  user          User           @relation("UserCompletions", fields: [userId], references: [id], onDelete: Cascade)
  program       Program?       @relation(fields: [programId], references: [id], onDelete: Cascade)
  futureProgram FutureProgram? @relation(fields: [futureProgramId], references: [id], onDelete: Cascade)
  district      District?      @relation(fields: [districtId], references: [id])
  feedback      Feedback?
  certificate   Certificate?

  @@index([userId])
  @@index([districtId])
}

// Feedback a completer leaves for the program they finished. Hidden until a
// super admin approves it, then shown publicly as a testimonial.
model Feedback {
  id           String   @id @default(cuid())
  completionId String   @unique
  rating       Int // 1..5 stars
  comment      String?
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  completion Completion @relation(fields: [completionId], references: [id], onDelete: Cascade)

  @@index([approved])
}

// ─────────────────────────────────────────────────────────────
// Branch posts (district announcements authored by branch admins)
// ─────────────────────────────────────────────────────────────

model Post {
  id         String   @id @default(cuid())
  districtId String
  authorId   String?
  title      String
  body       String
  imageUrl   String? // optional photo (data URL or external link)
  approved   Boolean  @default(false) // super admin must approve before it's public
  createdAt  DateTime @default(now())

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([districtId])
  @@index([createdAt])
}

model Center {
  id           String       @id @default(cuid())
  name         Json // { en, kn }
  districtId   String
  address      String?
  contactPhone String?
  status       CenterStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  district District @relation(fields: [districtId], references: [id])
  venues   Venue[]
  cohorts  Cohort[]
  expenses Expense[]

  @@index([districtId])
}

model Venue {
  id       String @id @default(cuid())
  centerId String
  name     String
  capacity Int?

  center   Center            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  sessions TrainingSession[]

  @@index([centerId])
}

// ─────────────────────────────────────────────────────────────
// Curriculum
// ─────────────────────────────────────────────────────────────

model Program {
  id            String   @id @default(cuid())
  name          Json // { en, kn }
  description   Json? // { en, kn }
  category      String?
  durationWeeks Int?
  status        String   @default("active")
  createdAt     DateTime @default(now())

  courses      Course[]
  cohorts      Cohort[]
  applications Application[]
  budget       Budget?
  expenses     Expense[]
  completions  Completion[]
}

model Course {
  id             String  @id @default(cuid())
  programId      String
  name           Json // { en, kn }
  description    Json? // { en, kn }
  sequence       Int     @default(0)
  hours          Int?
  moodleCourseId Int? // maps this course to a Moodle course (LMS integration)

  program  Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions TrainingSession[]

  @@index([programId])
}

// ─────────────────────────────────────────────────────────────
// Delivery: cohorts, sessions, attendance
// ─────────────────────────────────────────────────────────────

model Cohort {
  id            String       @id @default(cuid())
  programId     String
  centerId      String
  coordinatorId String?
  code          String?      @unique
  startDate     DateTime?
  endDate       DateTime?
  capacity      Int?
  status        CohortStatus @default(PLANNED)
  createdAt     DateTime     @default(now())

  program            Program             @relation(fields: [programId], references: [id])
  center             Center              @relation(fields: [centerId], references: [id])
  coordinator        Person?             @relation("CohortCoordinator", fields: [coordinatorId], references: [id])
  enrollments        Enrollment[]
  sessions           TrainingSession[]
  trainerAssignments TrainerAssignment[]
  expenses           Expense[]

  @@index([programId])
  @@index([centerId])
}

model Enrollment {
  id         String           @id @default(cuid())
  personId   String
  cohortId   String
  enrolledOn     DateTime         @default(now())
  status         EnrollmentStatus @default(ENROLLED)
  exitReason     String?
  moodleEnrolled Boolean          @default(false) // provisioned to Moodle?

  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  certificate Certificate?
  placements  Placement[]

  @@unique([personId, cohortId])
  @@index([cohortId])
}

model TrainingSession {
  id          String        @id @default(cuid())
  cohortId    String
  courseId    String
  venueId     String?
  trainerId   String?
  sessionDate DateTime
  startTime   String? // "HH:mm"
  endTime     String? // "HH:mm"
  topic       Json? // { en, kn }
  status      SessionStatus @default(SCHEDULED)

  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id])
  venue       Venue?       @relation(fields: [venueId], references: [id])
  trainer     Person?      @relation("SessionTrainer", fields: [trainerId], references: [id])
  attendances Attendance[]

  @@index([cohortId])
  @@index([sessionDate])
  @@map("training_sessions")
}

model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  personId   String
  status     AttendanceStatus @default(PRESENT)
  markedById String?
  markedAt   DateTime         @default(now())

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person   Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  markedBy User?           @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([sessionId, personId])
  @@index([personId])
}

model TrainerAssignment {
  id       String  @id @default(cuid())
  personId String
  cohortId String
  role     String? // e.g. "lead", "assistant"

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([personId, cohortId])
}

// ─────────────────────────────────────────────────────────────
// Compliance & supporting
// ─────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  personId   String
  type       String
  url        String
  uploadedAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model ConsentRecord {
  id          String   @id @default(cuid())
  personId    String
  consentType String
  version     String
  grantedAt   DateTime @default(now())
  ipAddress   String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Admissions (Phase 2)
// ─────────────────────────────────────────────────────────────

model Application {
  id          String            @id @default(cuid())
  firstName   String
  lastName    String?
  phone       String
  email       String?
  dateOfBirth DateTime?
  gender      Gender?
  districtId  String?
  programId   String? // training program of interest
  futureProgramId String? // set when applying to an announced future program
  aadhaarNumber String? // 12-digit Aadhaar registration number
  photoUrl    String? // applicant photo, captured on their phone (data URL)
  message     String? // free text from the applicant
  status      ApplicationStatus @default(SUBMITTED)
  reviewNote  String? // staff note
  consentAt   DateTime? // when the applicant gave DPDP consent
  ipAddress   String?
  personId    String?           @unique // set when converted to a trainee
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  district      District?      @relation(fields: [districtId], references: [id])
  program       Program?       @relation(fields: [programId], references: [id])
  futureProgram FutureProgram? @relation(fields: [futureProgramId], references: [id], onDelete: SetNull)
  person        Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([programId])
}

// ─────────────────────────────────────────────────────────────
// Certificates (Phase 3) — NGO's own format, with public verification
// ─────────────────────────────────────────────────────────────

model Certificate {
  id           String   @id @default(cuid())
  enrollmentId String?  @unique // set for enrollment-based certificates
  completionId String?  @unique // set for feedback-earned completion certificates
  personId     String
  serialNumber String   @unique // human-readable, e.g. MBV-2026-AB12CD
  verifyCode   String   @unique // opaque token for the public /verify URL
  personName   String // snapshot at issue time
  programName  Json // snapshot { en, kn }
  centerName   Json? // snapshot { en, kn }
  issuedAt     DateTime @default(now())
  issuedById   String?

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  completion Completion? @relation(fields: [completionId], references: [id], onDelete: Cascade)
  person     Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

// ─────────────────────────────────────────────────────────────
// Finance (Phase 4)
// ─────────────────────────────────────────────────────────────

model Budget {
  id        String   @id @default(cuid())
  programId String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  updatedAt DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(12, 2)
  incurredOn  DateTime
  category    String?
  vendor      String? // legacy free-text vendor (superseded by vendorId)
  note        String?
  status      ExpenseStatus @default(PENDING)
  programId   String?
  cohortId    String?
  centerId    String?
  vendorId    String?
  createdById String?
  createdAt   DateTime      @default(now())

  program       Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  cohort        Cohort?  @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  center        Center?  @relation(fields: [centerId], references: [id], onDelete: SetNull)
  vendorRecord  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([status])
  @@index([incurredOn])
}

model Vendor {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  note          String?
  createdAt     DateTime @default(now())

  expenses Expense[]
}

model Grant {
  id          String   @id @default(cuid())
  funder      String
  amount      Decimal  @db.Decimal(14, 2)
  reference   String?
  receivedOn  DateTime
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([receivedOn])
}

// ─────────────────────────────────────────────────────────────
// Placement & M&E (Phase 5)
// ─────────────────────────────────────────────────────────────

model Employer {
  id            String   @id @default(cuid())
  name          String
  sector        String?
  contactPerson String?
  phone         String?
  email         String?
  districtId    String?
  note          String?
  createdAt     DateTime @default(now())

  district   District?   @relation(fields: [districtId], references: [id])
  placements Placement[]

  @@index([districtId])
}

model Placement {
  id             String          @id @default(cuid())
  personId       String
  employerId     String
  enrollmentId   String?
  jobTitle       String?
  employmentType EmploymentType?
  monthlySalary  Decimal?        @db.Decimal(10, 2)
  placedOn       DateTime
  status         PlacementStatus @default(PLACED)
  note           String?
  createdById    String?
  createdAt      DateTime        @default(now())

  person     Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  employer   Employer    @relation(fields: [employerId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  followUps  FollowUp[]

  @@index([personId])
  @@index([employerId])
  @@index([status])
}

model FollowUp {
  id            String   @id @default(cuid())
  placementId   String
  followUpOn    DateTime
  periodMonths  Int? // months since placement (3, 6, 12…)
  stillEmployed Boolean  @default(true)
  monthlyIncome Decimal? @db.Decimal(10, 2)
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  placement Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([placementId])
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum PersonKind {
  TRAINEE
  TRAINER
  STAFF
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CONVERTED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
}

enum PlacementStatus {
  PLACED
  ACTIVE
  EXITED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  SELF_EMPLOYED
  APPRENTICESHIP
}

enum CenterStatus {
  ACTIVE
  INACTIVE
}

enum CohortStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
