// MBV — Manava Bandhutva Vedike — Occupational Training Platform
// Phase 1 data model (Training Operations Core) + Auth.js v5 models.
// See docs/DATA_MODEL.md for the ERD. Localized text fields use Json: { "en": "...", "kn": "..." }.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (CLI) and the
  // driver adapter in src/lib/prisma.ts (runtime) — not here.
}

// ─────────────────────────────────────────────────────────────
// Auth.js v5 (next-auth) — required adapter models
// `User` is also our application user (extended with app fields).
// ─────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // for Credentials sign-in (bcrypt)
  locale        String     @default("en") // "en" | "kn"
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts          Account[]
  sessions          Session[]
  person            Person?
  userRoles         UserRole[]
  attendancesMarked Attendance[] @relation("AttendanceMarkedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Trainee | Trainer | Coordinator | CenterManager | Finance | Placement | Admin
  description String?
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "attendance.mark", "cohort.manage"
  description String?

  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────────────────────────────────────────────
// People
// ─────────────────────────────────────────────────────────────

model Person {
  id          String     @id @default(cuid())
  userId      String?    @unique
  kind        PersonKind @default(TRAINEE) // trainee | trainer | staff
  firstName   String
  lastName    String?
  dateOfBirth DateTime?
  gender      Gender?
  phone       String?
  email       String?
  address     String?
  districtId  String?
  photoUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  district           District?           @relation(fields: [districtId], references: [id])
  enrollments        Enrollment[]
  attendances        Attendance[]
  trainerSessions    TrainingSession[]   @relation("SessionTrainer")
  coordinatedCohorts Cohort[]            @relation("CohortCoordinator")
  trainerAssignments TrainerAssignment[]
  documents          Document[]
  consentRecords     ConsentRecord[]

  @@index([districtId])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────
// Geography
// ─────────────────────────────────────────────────────────────

model District {
  id    String  @id @default(cuid())
  name  Json // { en, kn }
  code  String? @unique
  state String  @default("Karnataka")

  centers Center[]
  persons Person[]
}

model Center {
  id           String       @id @default(cuid())
  name         Json // { en, kn }
  districtId   String
  address      String?
  contactPhone String?
  status       CenterStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  district District @relation(fields: [districtId], references: [id])
  venues   Venue[]
  cohorts  Cohort[]

  @@index([districtId])
}

model Venue {
  id       String @id @default(cuid())
  centerId String
  name     String
  capacity Int?

  center   Center            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  sessions TrainingSession[]

  @@index([centerId])
}

// ─────────────────────────────────────────────────────────────
// Curriculum
// ─────────────────────────────────────────────────────────────

model Program {
  id            String   @id @default(cuid())
  name          Json // { en, kn }
  description   Json? // { en, kn }
  category      String?
  durationWeeks Int?
  status        String   @default("active")
  createdAt     DateTime @default(now())

  courses Course[]
  cohorts Cohort[]
}

model Course {
  id          String  @id @default(cuid())
  programId   String
  name        Json // { en, kn }
  description Json? // { en, kn }
  sequence    Int     @default(0)
  hours       Int?

  program  Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions TrainingSession[]

  @@index([programId])
}

// ─────────────────────────────────────────────────────────────
// Delivery: cohorts, sessions, attendance
// ─────────────────────────────────────────────────────────────

model Cohort {
  id            String       @id @default(cuid())
  programId     String
  centerId      String
  coordinatorId String?
  code          String?      @unique
  startDate     DateTime?
  endDate       DateTime?
  capacity      Int?
  status        CohortStatus @default(PLANNED)
  createdAt     DateTime     @default(now())

  program            Program             @relation(fields: [programId], references: [id])
  center             Center              @relation(fields: [centerId], references: [id])
  coordinator        Person?             @relation("CohortCoordinator", fields: [coordinatorId], references: [id])
  enrollments        Enrollment[]
  sessions           TrainingSession[]
  trainerAssignments TrainerAssignment[]

  @@index([programId])
  @@index([centerId])
}

model Enrollment {
  id         String           @id @default(cuid())
  personId   String
  cohortId   String
  enrolledOn DateTime         @default(now())
  status     EnrollmentStatus @default(ENROLLED)
  exitReason String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([personId, cohortId])
  @@index([cohortId])
}

model TrainingSession {
  id          String        @id @default(cuid())
  cohortId    String
  courseId    String
  venueId     String?
  trainerId   String?
  sessionDate DateTime
  startTime   String? // "HH:mm"
  endTime     String? // "HH:mm"
  topic       Json? // { en, kn }
  status      SessionStatus @default(SCHEDULED)

  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id])
  venue       Venue?       @relation(fields: [venueId], references: [id])
  trainer     Person?      @relation("SessionTrainer", fields: [trainerId], references: [id])
  attendances Attendance[]

  @@index([cohortId])
  @@index([sessionDate])
  @@map("training_sessions")
}

model Attendance {
  id         String           @id @default(cuid())
  sessionId  String
  personId   String
  status     AttendanceStatus @default(PRESENT)
  markedById String?
  markedAt   DateTime         @default(now())

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person   Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  markedBy User?           @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([sessionId, personId])
  @@index([personId])
}

model TrainerAssignment {
  id       String  @id @default(cuid())
  personId String
  cohortId String
  role     String? // e.g. "lead", "assistant"

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([personId, cohortId])
}

// ─────────────────────────────────────────────────────────────
// Compliance & supporting
// ─────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  personId   String
  type       String
  url        String
  uploadedAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model ConsentRecord {
  id          String   @id @default(cuid())
  personId    String
  consentType String
  version     String
  grantedAt   DateTime @default(now())
  ipAddress   String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum PersonKind {
  TRAINEE
  TRAINER
  STAFF
}

enum CenterStatus {
  ACTIVE
  INACTIVE
}

enum CohortStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
