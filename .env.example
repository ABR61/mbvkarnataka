# Copy this file to .env and fill in the values.

# PostgreSQL connection string. The default matches docker-compose.yml.
DATABASE_URL="postgresql://mbv:mbv_dev_password@localhost:5432/mbv?schema=public"

# Auth.js session secret. Generate one with:  npx auth secret
AUTH_SECRET=""

# Cloudflare R2 object storage for activity/programme photos.
# Leave blank in local dev — the app falls back to storing images as data URLs.
# In production, set all five so images upload to R2 instead. See docs/storage.md.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL the bucket is served from, no trailing slash.
# e.g. https://pub-xxxx.r2.dev  (dev)  or  https://images.mbvkarnataka.org  (prod)
R2_PUBLIC_BASE_URL=""

# Moodle LMS (optional, Phase 3). Leave blank to disable LMS sync.
# MOODLE_URL is the Moodle base URL; MOODLE_TOKEN is a Web Services token.
MOODLE_URL=""
MOODLE_TOKEN=""

# Rate limiting (brute-force / spam protection). All optional — the defaults
# below apply when unset. MAX = hits allowed per window; WINDOW_SEC = window
# length in seconds. See src/lib/rate-limit-config.ts.
# Login (per email+IP; only failed attempts count):
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_LOGIN_WINDOW_SEC="900"
# Public application form (per IP):
RATE_LIMIT_APPLY_MAX="5"
RATE_LIMIT_APPLY_WINDOW_SEC="3600"
# Certificate verification lookups (per IP):
RATE_LIMIT_VERIFY_MAX="20"
RATE_LIMIT_VERIFY_WINDOW_SEC="60"
# WebAuthn register/clock endpoints (per IP):
RATE_LIMIT_WEBAUTHN_MAX="10"
RATE_LIMIT_WEBAUTHN_WINDOW_SEC="60"
