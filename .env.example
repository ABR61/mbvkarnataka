# Copy this file to .env and fill in the values.

# PostgreSQL connection string. The default matches docker-compose.yml.
DATABASE_URL="postgresql://mbv:mbv_dev_password@localhost:5432/mbv?schema=public"

# Auth.js session secret. Generate one with:  npx auth secret
AUTH_SECRET=""

# Moodle LMS (optional, Phase 3). Leave blank to disable LMS sync.
# MOODLE_URL is the Moodle base URL; MOODLE_TOKEN is a Web Services token.
MOODLE_URL=""
MOODLE_TOKEN=""
